+
+class _NoExecutionTelemetryToyEnv:
+    n_agents = 2
+    def __init__(self):
+        self.state = {'t': 0}
+    def clone_state(self):
+        return dict(self.state)
+    def restore_state(self, state):
+        self.state = dict(state)
+    def step(self, actions):
+        self.state['t'] += 1
+        return None, [0.0, 1.0], False, {}
+
+
+def test_joint_oracle_fails_closed_without_executed_action_telemetry():
+    env = _NoExecutionTelemetryToyEnv()
+    oracle = CloneStateJointOracle(
+        env, snapshot=env.clone_state(), outcome_agent=1, baseline_actions=[0, 0]
+    )
+    try:
+        oracle.evaluate((0,), (1,))
+    except RuntimeError as exc:
+        assert 'executed-action telemetry' in str(exc)
+    else:
+        raise AssertionError('oracle must not treat requested actions as executed')
