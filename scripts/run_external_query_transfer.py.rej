 def _cost_total(cost):
     return int(sum(int(v) for v in cost.values()))
+
+
+def _query_discriminativeness(utility, k, tol=1e-12):
+    """Return the scientific non-degeneracy diagnostics for one query target.
+
+    A transfer score is not evidence when the target utility is constant, and a
+    Top-k comparison is not decision-discriminative when the k/(k+1) boundary
+    is tied.  Raw metrics are still retained for debugging, but such cells are
+    excluded from the aggregate transfer-performance numerator.
+    """
+    arr=np.asarray(utility,dtype=float).reshape(-1)
+    if arr.size < 2 or not np.all(np.isfinite(arr)):
+        return {'status':'EVALUABLE_DEGENERATE','scientific_evaluable':False,
+            'reason':'QUERY_TARGET_TOO_SMALL_OR_NONFINITE','utility_oscillation':0.0,
+            'topk_gap':None}
+    oscillation=float(np.max(arr)-np.min(arr))
+    if oscillation <= float(tol):
+        return {'status':'EVALUABLE_DEGENERATE','scientific_evaluable':False,
+            'reason':'QUERY_TARGET_CONSTANT','utility_oscillation':oscillation,
+            'topk_gap':0.0}
+    kk=int(k)
+    if not 0 < kk < arr.size:
+        return {'status':'EVALUABLE_DEGENERATE','scientific_evaluable':False,
+            'reason':'TOPK_BOUNDARY_UNDEFINED','utility_oscillation':oscillation,
+            'topk_gap':None}
+    order=np.argsort(-arr,kind='mergesort')
+    gap=float(arr[order[kk-1]]-arr[order[kk]])
+    if gap <= float(tol):
+        return {'status':'EVALUABLE_DEGENERATE','scientific_evaluable':False,
+            'reason':'TOPK_BOUNDARY_TIED','utility_oscillation':oscillation,
+            'topk_gap':gap}
+    return {'status':'EVALUABLE','scientific_evaluable':True,'reason':None,
+        'utility_oscillation':oscillation,'topk_gap':gap}
 
 
