namespace CIGAMF.P13.PaperCTwoMag2222FreeT

structure P2 where
  c0 : ℤ
  cs : ℤ
  ct : ℤ
  css : ℤ
  cst : ℤ
  ctt : ℤ

namespace P2

def add (p q : P2) : P2 :=
  ⟨p.c0 + q.c0, p.cs + q.cs, p.ct + q.ct, p.css + q.css, p.cst + q.cst, p.ctt + q.ctt⟩

def sub (p q : P2) : P2 :=
  ⟨p.c0 - q.c0, p.cs - q.cs, p.ct - q.ct, p.css - q.css, p.cst - q.cst, p.ctt - q.ctt⟩

def mul (p q : P2) : P2 :=
  ⟨p.c0 * q.c0, p.c0 * q.cs + p.cs * q.c0, p.c0 * q.ct + p.ct * q.c0, p.cs * q.cs,
    p.cs * q.ct + p.ct * q.cs, p.ct * q.ct⟩

def isLin (p : P2) : Bool := p.css == 0 && p.cst == 0 && p.ctt == 0

def nonneg (p : P2) : Bool :=
  decide (0 ≤ p.c0) && decide (0 ≤ p.cs) && decide (0 ≤ p.ct) && decide (0 ≤ p.css)
    && decide (0 ≤ p.cst) && decide (0 ≤ p.ctt)

noncomputable def ev (p : P2) (s t : ℝ) : ℝ :=
  p.c0 + p.cs * s + p.ct * t + p.css * s ^ 2 + p.cst * (s * t) + p.ctt * t ^ 2

end P2

def stepOK (mu : ℕ → P2) (κ ψ : ℕ → ℕ → ℕ → ℕ → P2) (x0 x1 x2 x3 y0 y1 y2 y3 : ℕ) : Bool :=
  (mu (x0 + x1 + x2 + x3)).isLin && (κ x0 x1 x2 x3).isLin &&
    (P2.add (P2.mul (mu (x0 + x1 + x2 + x3)) (κ x0 x1 x2 x3))
      (P2.sub (ψ y0 y1 y2 y3) (ψ x0 x1 x2 x3))).nonneg

def edgesOK (mu : ℕ → P2) (κ ψ : ℕ → ℕ → ℕ → ℕ → P2) : Bool :=
  (List.range 3).all fun x0 => (List.range 3).all fun x1 =>
  (List.range 3).all fun x2 => (List.range 3).all fun x3 =>
    (x0 == 2 || stepOK mu κ ψ x0 x1 x2 x3 (x0 + 1) x1 x2 x3) &&
    (x1 == 2 || stepOK mu κ ψ x0 x1 x2 x3 x0 (x1 + 1) x2 x3) &&
    (x2 == 2 || stepOK mu κ ψ x0 x1 x2 x3 x0 x1 (x2 + 1) x3) &&
    (x3 == 2 || stepOK mu κ ψ x0 x1 x2 x3 x0 x1 x2 (x3 + 1))

