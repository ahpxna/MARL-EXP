noncomputable def bkR2 (a b : ℝ) : ℕ → ℝ
  | 1 => b
  | 3 => a - 2 * b
  | 5 => a - 2 * b
  | 7 => b
  | _ => 0

theorem linkR2 (s t : ℝ) (hs : 0 ≤ s) (ht : 0 ≤ t) (x0 x1 x2 x3 : ℕ) (h0 : x0 ≤ 2) (h1 : x1 ≤ 2)
    (h2 : x2 ≤ 2) (h3 : x3 ≤ 2) :
    |(3 * s + 2 * t) * ((x0 : ℝ) - x1) + (s + t) * ((x2 : ℝ) - x3)|
      - bkR2 (3 * s + 2 * t) (s + t) (x0 + x1 + x2 + x3) = (kapR2 x0 x1 x2 x3).ev s t := by
  interval_cases x0 <;> interval_cases x1 <;> interval_cases x2 <;> interval_cases x3 <;>
    simp [bkR2, kapR2, P2.ev] <;>
    first
    | ring1
    | (rw [abs_of_nonneg (by linarith)]; ring1)
    | (rw [abs_of_nonpos (by linarith)]; ring1)
    | linarith

