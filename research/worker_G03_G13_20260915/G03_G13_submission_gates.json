    {
      "paper": "Query",
      "claim": "N* = Theta(h^{-2r}) and the regret window",
      "evidence": "LEAN THEOREM for the testing bracket, the rate assembly and the regret chain; NUMERICAL EVIDENCE for c_- and c_+; the Taylor remainders are measured"
    },
    {
      "paper": "MASTER",
      "claim": "c* = (m-1)^2/(m+3)^2; anchor mandatory at c0 = 1/10",
      "evidence": "LEAN THEOREM for the threshold on the symmetric family; EXACT FINITE CERTIFICATE (Fractions) for the mandatory-purchase instance"
