/-! ## Algebra of the endpoints -/

theorem seg_id1 {Q E QW α β : ℝ} (hQ : Q ≠ 0) (h : QW = α * Q - β * E) :
    QW / Q = α - β * (E / Q) := by
  rw [h]; field_simp

theorem seg_id2 {Q E QW A B Dd : ℝ} (hQ : Q ≠ 0) (hD : Dd ≠ 0) (h : QW * Dd = A * Q - B * E) :
    QW / Q = A / Dd - B / Dd * (E / Q) := by
  have e : A / Dd - B / Dd * (E / Q) = (A * Q - B * E) / (Dd * Q) := by field_simp
  rw [e, div_eq_div_iff hQ (mul_ne_zero hD hQ)]
  linear_combination Q * h

theorem const_id {Q QW N Dn : ℝ} (hQ : Q ≠ 0) (hD : Dn ≠ 0) (h : QW * Dn = N * Q) :
    QW / Q = N / Dn := by
  rw [div_eq_div_iff hQ hD]; exact h

/-! ## Flows, segments, and the free value at every band -/

theorem value_le_ex8 (hb : 0 < b) (hab : b < a) (η e X : ℝ) (he : e ≤ η)
    (hfl : ∃ F : LayeredFlow (CState 4 8), CountFeasibleH ty8 F ∧ FlowBand ty8 F e
      ∧ ∀ k ∈ K7, flowObj (typedCost ty8 (wt a b)) F k ≤ X / (4 * (a + b))) :
    trueValue (g8 a b) η K7 K7_ne ≤ X / (4 * (a + b)) := by
  obtain ⟨F, hF, hB, hk⟩ := hfl
  exact value_le_of_flow hb hab η F hF (band_mono ty8 F e η hB he (by norm_num)) _ hk

/-- Two flows on the affine line `α - βη` at their bands `e₀ ≤ e₁` give that line on `[e₀, e₁]`. -/
theorem up_seg8 (hb : 0 < b) (hab : b < a) (α β e0 e1 X0 X1 η : ℝ) (he : e0 ≤ e1)
    (h0 : e0 ≤ η) (h1 : η ≤ e1) (hX0 : X0 = α - β * e0) (hX1 : X1 = α - β * e1)
    (F0 : ∃ F : LayeredFlow (CState 4 8), CountFeasibleH ty8 F ∧ FlowBand ty8 F e0
      ∧ ∀ k ∈ K7, flowObj (typedCost ty8 (wt a b)) F k ≤ X0 / (4 * (a + b)))
    (F1 : ∃ F : LayeredFlow (CState 4 8), CountFeasibleH ty8 F ∧ FlowBand ty8 F e1
      ∧ ∀ k ∈ K7, flowObj (typedCost ty8 (wt a b)) F k ≤ X1 / (4 * (a + b))) :
    trueValue (g8 a b) η K7 K7_ne ≤ (α - β * η) / (4 * (a + b)) := by
  rcases eq_or_lt_of_le he with heq | hlt
  · have hη : η = e0 := by linarith
    rw [hη, ← hX0]
    exact value_le_ex8 hb hab e0 e0 X0 le_rfl F0
  obtain ⟨F, hF, hFb, hFk⟩ := F0
  obtain ⟨G, hG, hGb, hGk⟩ := F1
  have hd : 0 < e1 - e0 := sub_pos.2 hlt
  have hd' : e1 - e0 ≠ 0 := hd.ne'
  have hD : 4 * (a + b) ≠ 0 := by apply ne_of_gt; linarith
  have hθ0 : 0 ≤ (η - e0) / (e1 - e0) := div_nonneg (by linarith) hd.le
  have hθ1 : (η - e0) / (e1 - e0) ≤ 1 := (div_le_one hd).2 (by linarith)
  have hθ' : 0 ≤ 1 - (η - e0) / (e1 - e0) := by linarith
  refine value_le_of_flow hb hab η (mixTwo _ hθ0 hθ1 F G) (mixTwo_feasible ty8 _ hθ0 hθ1 F G hF hG)
    ?_ _ (fun k hk => ?_)
  · have hB := mixTwo_band ty8 _ hθ0 hθ1 F G hF hG e0 e1 hFb hGb
    convert hB using 1
    field_simp
    try ring
  · rw [mixTwo_obj]
    calc (1 - (η - e0) / (e1 - e0)) * flowObj (typedCost ty8 (wt a b)) F k
          + (η - e0) / (e1 - e0) * flowObj (typedCost ty8 (wt a b)) G k
        ≤ (1 - (η - e0) / (e1 - e0)) * (X0 / (4 * (a + b)))
          + (η - e0) / (e1 - e0) * (X1 / (4 * (a + b))) :=
          add_le_add (mul_le_mul_of_nonneg_left (hFk k hk) hθ')
            (mul_le_mul_of_nonneg_left (hGk k hk) hθ0)
      _ = (α - β * η) / (4 * (a + b)) := by
          rw [hX0, hX1]
          field_simp
          try ring

/-- The free value is a lower bound at every band. -/
theorem low_free8 (hb : 0 < b) (hab : b < a) (X η : ℝ) (hη : 0 ≤ η)
    (h : X ≤ trueValue (g8 a b) 8 K7 K7_ne) : X ≤ trueValue (g8 a b) η K7 K7_ne := by
  have hg : 0 < normMass (g8 a b) := by rw [normMass_g8 hb hab]; linarith
  have := free_le_value (g8 a b) hg K7 K7_ne η hη
  rw [vfree8] at this
  linarith

