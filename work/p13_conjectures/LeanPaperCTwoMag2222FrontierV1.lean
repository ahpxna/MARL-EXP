/-- The seven regions cover every ratio `a/b > 1`. -/
theorem regions8_cover (hb : 0 < b) (hab : b < a) :
    a ≤ 2 * b ∨ (2 * b ≤ a ∧ a ≤ 3 * b ∧ 0 ≤ a ^ 2 - 10 * a * b + 17 * b ^ 2) ∨ (a ^ 2 - 10 * a * b + 17 * b ^ 2 ≤ 0 ∧ 3 * a ≤ 7 * b)
      ∨ (7 * b ≤ 3 * a ∧ 7 * a ≤ 17 * b) ∨ (17 * b ≤ 7 * a ∧ 21 * a ≤ 53 * b)
      ∨ (53 * b ≤ 21 * a ∧ a ≤ 3 * b) ∨ 3 * b ≤ a := by
  by_cases h1 : a ≤ 2 * b; · exact Or.inl h1
  by_cases h2 : 3 * a ≤ 7 * b
  · rcases le_total 0 (a ^ 2 - 10 * a * b + 17 * b ^ 2) with hq | hq
    · exact Or.inr (Or.inl ⟨by linarith, by linarith, hq⟩)
    · exact Or.inr (Or.inr (Or.inl ⟨hq, h2⟩))
  by_cases h3 : 7 * a ≤ 17 * b; · exact Or.inr (Or.inr (Or.inr (Or.inl ⟨by linarith, h3⟩)))
  by_cases h4 : 21 * a ≤ 53 * b
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨by linarith, h4⟩))))
  by_cases h5 : a ≤ 3 * b
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨by linarith, h5⟩)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (by linarith))))))

theorem regions8_nonempty :
    ((3 / 2 : ℝ) ≤ 2 * 1) ∧ (2 * 1 ≤ (21 / 10 : ℝ) ∧ (21 / 10 : ℝ) ≤ 3 * 1
        ∧ 0 ≤ (21 / 10 : ℝ) ^ 2 - 10 * (21 / 10) * 1 + 17 * 1 ^ 2)
      ∧ ((23 / 10 : ℝ) ^ 2 - 10 * (23 / 10) * 1 + 17 * 1 ^ 2 ≤ 0 ∧ 3 * (23 / 10 : ℝ) ≤ 7 * 1)
      ∧ (7 * 1 ≤ 3 * (12 / 5 : ℝ) ∧ 7 * (12 / 5 : ℝ) ≤ 17 * 1)
      ∧ (17 * 1 ≤ 7 * (5 / 2 : ℝ) ∧ 21 * (5 / 2 : ℝ) ≤ 53 * 1)
      ∧ (53 * 1 ≤ 21 * (14 / 5 : ℝ) ∧ (14 / 5 : ℝ) ≤ 3 * 1) ∧ 3 * 1 ≤ (4 : ℝ) := by
  norm_num

