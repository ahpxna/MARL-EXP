/-! ## The lines -/

noncomputable def lineL1 (a b η : ℝ) : ℝ := (a - b) * (1 - η) / 2
noncomputable def lineL2p (a b η : ℝ) : ℝ := 3 * (a - b) / 4 - η * (a - b) / 8
noncomputable def lineL2 (a b η : ℝ) : ℝ := (5 * b - a) / 4 - η * (a - b) / 8
noncomputable def lineL3 (a b η : ℝ) : ℝ :=
  (3 * b - a) * (2 * (a ^ 2 - 2 * a * b + 3 * b ^ 2) - η * (a - b) * (3 * b - a))
    / (2 * (a - b) * (10 * b - 3 * a))

