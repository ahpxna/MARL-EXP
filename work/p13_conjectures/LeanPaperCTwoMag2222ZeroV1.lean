/-- Clearing the mixing weight. -/
theorem mix_le (S1 S2 W X Y θ : ℝ) (hY : 0 < Y) (hθ : θ = X / Y)
    (h : Y * S1 + X * (S2 - S1) ≤ Y * W) : (1 - θ) * S1 + θ * S2 ≤ W := by
  rw [hθ]
  have e : (1 - X / Y) * S1 + X / Y * S2 = (Y * S1 + X * (S2 - S1)) / Y := by
    field_simp
    ring
  rw [e, div_le_iff₀ hY]
  linarith

