  have hY : 0 < 2 * (3 * b - a) := by linarith
  set θ := (7 * b - 3 * a) / (2 * (3 * b - a)) with hθ
  have hθ0 : 0 ≤ θ := div_nonneg (by linarith) hY.le
  have hθ1 : θ ≤ 1 := by rw [hθ, div_le_one hY]; linarith
  have hB := mixTwo_band ty8 θ hθ0 hθ1 flIIa flIIb flIIa_feas flIIb_feas 0 0 flIIa_band flIIb_band
  rw [show (1 - θ) * 0 + θ * 0 = (0 : ℝ) by ring] at hB
  refine value_le_of_flow hb hab 0 _ (mixTwo_feasible ty8 θ hθ0 hθ1 flIIa flIIb flIIa_feas flIIb_feas)
    hB _ fun k hk => ?_
  rw [mixTwo_obj, objIIa hb hab h2 h7 k hk, objIIb hb hab h2 h7 k hk]
  rw [show (1 - θ) * (SIIa a b k / (4 * (a + b))) + θ * (SIIb a b k / (4 * (a + b)))
      = ((1 - θ) * SIIa a b k + θ * SIIb a b k) / (4 * (a + b)) by ring]
  refine div_le_div_of_nonneg_right ?_ hD.le
  refine mix_le _ _ _ (7 * b - 3 * a) _ θ hY hθ ?_
  have hp : 0 ≤ (7 * b - 3 * a) * (3 * b - a) := mul_nonneg (by linarith) (by linarith)
  simp only [K7, Finset.mem_insert, Finset.mem_singleton] at hk
  rcases hk with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp [SIIa, SIIb] <;> nlinarith [hp]

/-- **`D·V_g(0) = 3(a-b)/4` for `a ≤ 2b`.** -/
theorem zero2222_L (hb : 0 < b) (hab : b < a) (h2 : a ≤ 2 * b) :
    trueValue (g8 a b) 0 K7 K7_ne = 3 * (a - b) / 4 / (4 * (a + b)) := by
  apply le_antisymm (zero_up_I hb hab h2)
  refine le_trans (le_of_eq ?_) (lower_L2lo hb hab h2 0 le_rfl)
  ring

/-- **`D·V_g(0) = (5b-a)/4` for `2b ≤ a ≤ 7b/3`.** -/
theorem zero2222_M (hb : 0 < b) (hab : b < a) (h2 : 2 * b ≤ a) (h7 : 3 * a ≤ 7 * b) :
    trueValue (g8 a b) 0 K7 K7_ne = (5 * b - a) / 4 / (4 * (a + b)) := by
  apply le_antisymm (zero_up_II hb hab h2 h7)
  refine le_trans (le_of_eq ?_) (lower_L2mid hb h2 (by linarith) 0 le_rfl)
  ring

/-- **`D·V_g(0) = (a-b)/2` for `a ≥ 7b/3`.** -/
theorem zero2222_H (hb : 0 < b) (hab : b < a) (h7 : 7 * b ≤ 3 * a) :
    trueValue (g8 a b) 0 K7 K7_ne = (a - b) / 2 / (4 * (a + b)) := by
  apply le_antisymm (zero_up_III hb hab h7)
  refine le_trans (le_of_eq ?_) (lower_L1 hb hab 0 le_rfl)
  ring

