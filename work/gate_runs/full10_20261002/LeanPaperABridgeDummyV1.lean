import «LeanPaperABridgeV1»

/-!
# Paper A: the bridge with a FRESH dummy query, so that no cell of the experiment is pinned

`LeanPaperABridgeV1.stream_eq_hist` is stated for any query type `Q` and any designated query
`d`, and the channel `gChan d s` pins the mean of `d` to `0` in EVERY world (`mz d m`).  That is
correct for the transformed model but it must NOT be instantiated with `d` a cell of Paper A's
experiment: all cells are measured, and an alternative may move any of them.  Doing so would
silently remove one coordinate from every world and from every alternative.

The instantiation used for Paper A adds a fresh query instead: the query type is `E ⊕ Unit`,
the dummy is `Sum.inr ()`, and a world is a mean vector `m : E → ℝ` on the REAL cells, lifted by
`lift m = Sum.elim m 0`.  Then:

* `mz_lift` -- pinning the dummy changes nothing: `mz dummy (lift m) = lift m`;
* `stream_eq_hist_fresh` -- the bridge holds for the lifted world, with the stream observations
  generated by `lift m` itself;
* `obsKernel_real_cell` -- a real cell `e` is observed as `N(m e, s_e^2)` in world `m`, with no
  constraint on `m e`;
* `lift_injective` -- distinct mean vectors on the real cells are distinct worlds, so the
  alternatives of the experiment range over ALL of `E → ℝ`.

The dummy is what a stopped learner issues after its stopping time; it carries no information
(its law is the same in every world, `dummy_same`).
-/

namespace CIGAMF.P13.PaperABridgeDummy

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal
open CIGAMF.P13.PaperA7Stream CIGAMF.P13.PaperA7Process CIGAMF.P13.PaperABridge
open CIGAMF.P13.PaperBProtocol CIGAMF.P13.PaperBConcentration

variable {E : Type*} [Fintype E] [DecidableEq E] [MeasurableSpace E] [MeasurableSingletonClass E]

/-- Singletons of a sum of measurable-singleton spaces are measurable (used for the extended
query type `E ⊕ Unit`, and for the family's own cell type `Fin 4 ⊕ (Fin r × Bool)`). -/
instance instMSCSum {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    [MeasurableSingletonClass α] [MeasurableSingletonClass β] :
    MeasurableSingletonClass (α ⊕ β) :=
  ⟨fun x => by
    cases x with
    | inl a =>
        rw [← Set.image_singleton]
        exact measurableSet_inl_image.mpr (measurableSet_singleton a)
    | inr b =>
        rw [← Set.image_singleton]
        exact measurableSet_inr_image.mpr (measurableSet_singleton b)⟩

/-- The fresh dummy query. -/
def dummyQ : E ⊕ Unit := Sum.inr ()

/-- A world on the real cells, lifted to the extended query type. -/
def lift (m : E → ℝ) : E ⊕ Unit → ℝ := Sum.elim m (fun _ => 0)

theorem mz_lift (m : E → ℝ) : mz (dummyQ (E := E)) (lift m) = lift m := by
  funext q
  cases q with
  | inl e => simp [mz, lift, dummyQ]
  | inr u => simp [mz, lift, dummyQ]

/-- **The bridge, with a fresh dummy.** -/
theorem stream_eq_hist_fresh (L : Learner (E ⊕ Unit)) (s : E ⊕ Unit → ℝ) (hs : ∀ q, 0 < s q)
    (m : E → ℝ) (n : ℕ) :
    streamMeasure.map (fun ω => histF L (lift m) s n (Xp n ω))
      = hist (gChan dummyQ s hs) (detPol L) (lift m) n := by
  have h := stream_eq_hist L dummyQ s hs (lift m) n
  rw [mz_lift] at h
  exact h

/-- **A real cell is observed with its own mean, unconstrained.** -/
theorem obsKernel_real_cell (s : E ⊕ Unit → ℝ) (hs : ∀ q, 0 < s q) (m : E → ℝ) (n : ℕ)
    (x : Hist (E ⊕ Unit) n × (E ⊕ Unit)) (e : E) (hx : x.2 = Sum.inl e) :
    obsKernel (gChan dummyQ s hs) (lift m) n x = gaussianReal (m e) (vq s (Sum.inl e)) := by
  rw [obsKernel_gChan, hx]
  simp [mz, lift, dummyQ]

/-- Distinct real-cell mean vectors are distinct worlds. -/
theorem lift_injective : Function.Injective (lift (E := E)) := by
  intro m m' h
  funext e
  have := congrFun h (Sum.inl e)
  simpa [lift] using this

#print axioms mz_lift
#print axioms stream_eq_hist_fresh
#print axioms obsKernel_real_cell
#print axioms lift_injective

end CIGAMF.P13.PaperABridgeDummy
