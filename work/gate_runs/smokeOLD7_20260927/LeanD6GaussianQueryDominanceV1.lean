import «LeanD6PhaseTestingInformationV1»
import Mathlib.Probability.Distributions.Gaussian.Real

/-! The known-A Gaussian experiment generated by B-off dominates every legal
D6 query. The simulator is independent of the margin. This is an equality of
actual probability laws for one query with fresh independent Gaussian noise.
No adaptive-transcript or stopping-time theorem is asserted here. -/
namespace CIGAMF.P13.D6GaussianQueryDominance
open Finset MeasureTheory ProbabilityTheory
open CIGAMF.P13.D6Threshold CIGAMF.P13.D6AllocationFiniteBridge
open CIGAMF.P13.D6AllocationDualBridge CIGAMF.P13.D6PhaseTestingInformation
open CIGAMF.V4.ProductSurrogate CIGAMF.V4.ProductMixedDifference
noncomputable section
variable {n : ℕ}

def actualMean (A : Finset (I n)) (j : I n) (mu : ℝ) : Measurement n → ℝ
  | .inl i => productResponse corner (world A j mu) i true
  | .inr (G,h) => world A j mu (query G j h)

def meanSlope (A : Finset (I n)) (j : I n) : Measurement n → ℝ
  | .inl i => if i ∈ A then 0 else if i=j then 1 else -1
  | .inr (G,h) => -(((G ∩ others A j).card : ℝ)-bit h)

def meanOffset (A : Finset (I n)) (j : I n) : Measurement n → ℝ
  | .inl i => if i ∈ A then 1 else if i=j then -1 else 1
  | .inr (G,h) => (if h then 0 else 1)+(((G ∩ others A j).card : ℝ)-bit h)

/-- Actual construction means, not hypothetical regression coefficients. -/
theorem actual_mean_affine (A : Finset (I n)) (j : I n) (hj : j ∉ A)
    (q mu : ℝ) (e : Measurement n) (he : Legal j q e) :
    actualMean A j mu e = meanOffset A j e+meanSlope A j e*mu := by
  cases e with
  | inl i =>
    dsimp [actualMean,meanOffset,meanSlope]
    rw [world_response A j hj]
    by_cases hi : i ∈ A
    · simp [CIGAMF.P13.D6Threshold.slope,hi,bit_true]
    · by_cases hij : i=j
      · simp [CIGAMF.P13.D6Threshold.slope,hj,hij,bit_true]
        <;> ring
      · simp [CIGAMF.P13.D6Threshold.slope,hi,hij,bit_true]
        <;> ring
  | inr p =>
    dsimp [actualMean,meanOffset,meanSlope]
    rw [actual_query_mean A p.1 j p.2 hj he.1 he.2.2]
    ring

theorem actual_mean_slope_bound (A : Finset (I n)) (j : I n) (q : ℝ)
    (hq : 1 ≤ q) (e : Measurement n) (he : Legal j q e) :
    (meanSlope A j e)^2 ≤ q^2 := by
  cases e with
  | inl i => dsimp [meanSlope]; split_ifs <;> nlinarith
  | inr p =>
    dsimp [meanSlope]
    rw [neg_sq]
    exact joint_sensitivity_bound A p.1 j p.2 q hq he.2.1

theorem B_off_mean (A : Finset (I n)) (j : I n) (q : ℝ)
    (hq : 2 ≤ q) (hj : j ∉ A) (hB : ((others A j).card : ℝ)=q) (mu : ℝ) :
    actualMean A j mu (.inr (others A j,false))=1+q-q*mu := by
  rw [actual_mean_affine A j hj q mu _ (B_off_attains A j q hq hj hB mu mu).1]
  simp only [meanOffset,meanSlope,Bool.false_eq_true,↓reduceIte,inter_self,bit_false,sub_zero,hB]
  ring

/-- A fresh independent standard Gaussian fills exactly the missing variance. -/
theorem gaussian_garbling {Ω : Type*} [MeasurableSpace Ω] {P : Measure Ω}
    {X Z : Ω → ℝ} (v c d : ℝ) (hc : c^2 ≤ 1)
    (hX : HasLaw X (gaussianReal v 1) P)
    (hZ : HasLaw Z (gaussianReal 0 1) P) (hXZ : IndepFun X Z P) :
    HasLaw (fun ω => c*X ω+Real.sqrt (1-c^2)*Z ω+d)
      (gaussianReal (c*v+d) 1) P := by
  let s := Real.sqrt (1-c^2)
  have hs : s^2=1-c^2 := Real.sq_sqrt (by linarith)
  have hX' := gaussianReal_const_mul hX c
  have hZ' := gaussianReal_const_mul hZ s
  have hi : IndepFun (fun ω => c*X ω) (fun ω => s*Z ω) P := by
    exact hXZ.comp (by fun_prop) (by fun_prop)
  have hv : NNReal.mk (c^2) (sq_nonneg c)*1+
      NNReal.mk (s^2) (sq_nonneg s)*1=1 := by
    apply Subtype.ext
    change c^2*1+s^2*1=(1 : ℝ)
    linarith
  have hsum : HasLaw (fun ω => c*X ω+s*Z ω) (gaussianReal (c*v) 1) P := by
    refine ⟨hX'.aemeasurable.add hZ'.aemeasurable,?_⟩
    have hh := gaussianReal_add_gaussianReal_of_indepFun hi hX' hZ'
    have hfun : ((fun ω => c*X ω) + (fun ω => s*Z ω)) =
        (fun ω => c*X ω+s*Z ω) := by
      funext ω
      rfl
    rw [hfun] at hh
    simpa only [mul_zero,add_zero,hv] using hh
  exact gaussianReal_add_const hsum d

/-- Coefficients of the query simulator depend on A, j, q and the requested
query, and do not depend on the unknown margin. -/
def simulate (A : Finset (I n)) (j : I n) (q : ℝ) (e : Measurement n)
    (x z : ℝ) : ℝ :=
  (-(meanSlope A j e/q))*x+
    Real.sqrt (1-(-(meanSlope A j e/q))^2)*z+
      (meanOffset A j e+(meanSlope A j e/q)*(1+q))

/-- One B-off observation plus independent Gaussian randomization reproduces
exactly the Gaussian law of any actual legal query, simultaneously for all mu. -/
theorem actual_query_gaussian_dominance {Ω : Type*} [MeasurableSpace Ω]
    {P : Measure Ω} {X Z : Ω → ℝ} (A : Finset (I n)) (j : I n) (q : ℝ)
    (hq : 2 ≤ q) (hj : j ∉ A) (hB : ((others A j).card : ℝ)=q)
    (e : Measurement n) (he : Legal j q e) (mu : ℝ)
    (hX : HasLaw X (gaussianReal (actualMean A j mu (.inr (others A j,false))) 1) P)
    (hZ : HasLaw Z (gaussianReal 0 1) P) (hXZ : IndepFun X Z P) :
    HasLaw (fun ω => simulate A j q e (X ω) (Z ω))
      (gaussianReal (actualMean A j mu e) 1) P := by
  have hqpos : 0 < q := by linarith
  have hqne : q ≠ 0 := ne_of_gt hqpos
  have hb := actual_mean_slope_bound A j q (by linarith) e he
  have hc : (-(meanSlope A j e/q))^2 ≤ 1 := by
    rw [neg_sq,div_pow]
    exact (div_le_one (sq_pos_of_pos hqpos)).mpr hb
  rw [B_off_mean A j q hq hj hB mu] at hX
  have hh := gaussian_garbling (1+q-q*mu) (-(meanSlope A j e/q))
    (meanOffset A j e+(meanSlope A j e/q)*(1+q)) hc hX hZ hXZ
  have hm : -(meanSlope A j e/q)*(1+q-q*mu)+
      (meanOffset A j e+(meanSlope A j e/q)*(1+q)) = actualMean A j mu e := by
    rw [actual_mean_affine A j hj q mu e he]
    field_simp [hqne]
    ring
  rw [hm] at hh
  exact hh

#print axioms actual_mean_affine
#print axioms actual_mean_slope_bound
#print axioms B_off_mean
#print axioms gaussian_garbling
#print axioms actual_query_gaussian_dominance
end
end CIGAMF.P13.D6GaussianQueryDominance
