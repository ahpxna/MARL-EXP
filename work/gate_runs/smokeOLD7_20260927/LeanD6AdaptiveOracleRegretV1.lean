import «LeanGaussianProductDecisionRiskV1»
import «LeanD6CenteredTranscriptV1»
import «LeanD6LocalOracleRegretV1»

/-! Full finite-horizon adaptive lower bound for the actual D6 allocation
oracle regret. The probability law is generated by the real legal queries;
no transcript overlap or Gaussian-risk conclusion is assumed as a premise. -/
namespace CIGAMF.P13.D6AdaptiveOracleRegret
open MeasureTheory ProbabilityTheory
open scoped BigOperators
open CIGAMF.P13.AdaptiveTranscriptKernel CIGAMF.P13.D6AdaptiveTranscript
open CIGAMF.P13.D6CenteredTranscript CIGAMF.P13.GaussianProductDecisionRisk
open CIGAMF.P13.D6GaussianOverlap CIGAMF.P13.D6LocalOracleRegret
open CIGAMF.P13.D6Threshold CIGAMF.P13.D6AllocationDualBridge
open CIGAMF.P13.D6GaussianQueryDominance CIGAMF.P13.D6AllocationRiskBridge
open CIGAMF.P13.D6AllocationMargin CIGAMF.P13.D6AllocationMarginRegion
open CIGAMF.P13.D6AllocationPhaseThreeFeasible CIGAMF.P13.D6ExpandedAllocation
noncomputable section
variable {n : ℕ} {H : Type*} [MeasurableSpace H]

lemma allocation_value_nonnegative (A : Finset (I n)) (j : I n) (mu : ℝ)
    (E : Finset (Measurement n)) (w : Measurement n → ℝ) (hw : ∀ e ∈ E,0 ≤ w e) :
    0 ≤ allocationValue A j mu E w := by
  apply Real.sInf_nonneg
  rintro v ⟨A',nu,h,rfl⟩
  exact Finset.sum_nonneg (fun e he => mul_nonneg (hw e he) (information_nonnegative A A' j mu nu e))

lemma oracle_regret_bounded (A : Finset (I n)) (j : I n) (q mu : ℝ)
    (E : Finset (Measurement n)) (w : Measurement n → ℝ) (hw : ∀ e ∈ E,0 ≤ w e) :
    oracleRegret A j q mu E w ≤ max 0 (oracleValue A j q mu) := by
  apply max_le_max le_rfl
  exact sub_le_self _ (allocation_value_nonnegative A j mu E w hw)

/-- Every measurable allocation recommendation from a full adaptive Gaussian
query history has the local two-margin lower bound. The state H can contain
the entire history and an arbitrary parameter-independent random seed. -/
theorem adaptive_oracle_regret_lower
    (A : Finset (I n)) (j : I n) (q lam eps : ℝ)
    (hq : 3 ≤ q) (hI : Interior q lam) (hminus : Interior q (lam+eps))
    (hpluslo : marginMax q ≤ (1-lam)+eps) (hplushi : (1-lam)+eps ≤ marginHigh q)
    (hj : j ∉ A) (hA : (A.card : ℝ)=q+1) (hB : ((others A j).card : ℝ)=q)
    (heps : 0 ≤ eps) (hlo : eps ≤ 1-lam*(1+root q (scale q)))
    (hup : eps ≤ lam*(1+root q (scale q)))
    (initial : Kernel Unit H) [IsMarkovKernel initial]
    (policy : ℕ → H → Measurement n) (legal : ∀ t h,Legal j q (policy t h))
    (ha : ∀ t,Measurable (fun h => meanOffset A j (policy t h)))
    (hb : ∀ t,Measurable (fun h => meanSlope A j (policy t h)))
    (update : ℕ → H × ℝ → H) (hu : ∀ t,Measurable (update t))
    (E : Finset (Measurement n)) (w : H → Measurement n → ℝ)
    (feasible : ∀ h,Feasible j q E (w h))
    (hmLoss : Measurable (fun h => oracleRegret A j q ((1-lam)-eps) E (w h)))
    (hpLoss : Measurable (fun h => oracleRegret A j q ((1-lam)+eps) E (w h)))
    (N : ℕ) (hN : 0 < N) :
    ∃ hm : ∀ mu t,Measurable (fun h => actualMean A j mu (policy t h)),
      (rate q (lam+eps)+D6PhaseThreeSharp.rate q ((1-lam)+eps)-2*rate q lam-eps^2)*
        standardTail (q*eps*Real.sqrt N) ≤
      max
        (∫ h,oracleRegret A j q ((1-lam)-eps) E (w h) ∂trajectory initial
          (fun t => actualStep (fun h => actualMean A j ((1-lam)-eps) (policy t h))
            (hm ((1-lam)-eps) t) (update t) (hu t)) N ())
        (∫ h,oracleRegret A j q ((1-lam)+eps) E (w h) ∂trajectory initial
          (fun t => actualStep (fun h => actualMean A j ((1-lam)+eps) (policy t h))
            (hm ((1-lam)+eps) t) (update t) (hu t)) N ()) := by
  obtain ⟨hm,K,hK,ht⟩ := centered_transcript A j q (1-lam) (by linarith) hj hB
    initial policy legal ha hb update hu N
  letI := hK
  refine ⟨hm,?_⟩
  have h := markov_product_risk_lower (q*eps) (mul_nonneg (by linarith) heps) N hN K
    (fun h => oracleRegret A j q ((1-lam)-eps) E (w h))
    (fun h => oracleRegret A j q ((1-lam)+eps) E (w h)) hmLoss hpLoss
    (max 0 (oracleValue A j q ((1-lam)-eps))) (max 0 (oracleValue A j q ((1-lam)+eps)))
    (rate q (lam+eps)+D6PhaseThreeSharp.rate q ((1-lam)+eps)-2*rate q lam-eps^2)
    (fun _ => le_max_left _ _) (fun _ => le_max_left _ _)
    (fun h => oracle_regret_bounded A j q ((1-lam)-eps) E (w h) (feasible h).2.1)
    (fun h => oracle_regret_bounded A j q ((1-lam)+eps) E (w h) (feasible h).2.1)
    (fun h => local_oracle_regret_separation A j q lam eps hq hI hminus hpluslo hplushi
      hj hA hB heps hlo hup E (w h) (feasible h))
  have hmMean : q*(((1-lam)-eps)-(1-lam))= -(q*eps) := by ring
  have hpMean : q*(((1-lam)+eps)-(1-lam))=q*eps := by ring
  have em := ht ((1-lam)-eps)
  have ep := ht ((1-lam)+eps)
  rw [hmMean] at em
  rw [hpMean] at ep
  rw [em,ep] at h
  exact h

#print axioms allocation_value_nonnegative
#print axioms oracle_regret_bounded
#print axioms adaptive_oracle_regret_lower
end
end CIGAMF.P13.D6AdaptiveOracleRegret
